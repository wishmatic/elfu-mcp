# MCP/Internals (optional)

HOST=0.0.0.0
PORT=8080

LOG_LEVEL=info # debug, info, warn, error, dpanic, panic, fatal

# Auth

API_KEY=change-me

# Where inline can read a URL from, as comma-separated public=private pairs.
# The private side is either an absolute http(s) base URL, or a directory to read from.
# A directory entry's public key is the only access control for that directory, so make it long and unguessable.

# LibreChat's uploaded images, with its images directory mounted (for example
# /mnt/user/appdata/librechat/client/public/images at /data/librechat-data):
# INLINE_URL_MAP=https://chat.example.com/images/=/data/librechat-data

# Images served by another MCP on this network, reached under a private name:
# INLINE_URL_MAP=https://neo.example.com=http://neo-mcp:8080

INLINE_URL_MAP=

# Files

PUBLIC_HOST=
FILES_DIR=files # "files" resolves to /data/files
